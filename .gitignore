# One .gitignore for the whole repo: it applies to every game folder
# (the root Langur Burja project and ludo/).

# Dependencies (reinstall with `npm install` in each folder)
node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment / secrets (e.g. HOST_PASSWORD)
.env
.env.*
!.env.example

# Build output / caches
dist/
build/
coverage/
.cache/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
